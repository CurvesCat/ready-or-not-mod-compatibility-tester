<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="RoNCT.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RoNCT.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The TitleBar template reserves a right-side drag region by
                 default. Setting it to zero lets the action buttons sit next
                 to the system minimize/maximize/close buttons. -->
            <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
