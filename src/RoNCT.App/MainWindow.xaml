<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="RoNCT.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="RoNCT"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="RoNCT"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/logo_meme.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel
                    x:Name="TitleBarActionsPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,12,0">
                    <Button
                        x:Name="TitleHelpButton"
                        Click="TitleHelpButton_Click"
                        Padding="12,5" />
                    <Button
                        x:Name="TitleAboutButton"
                        Click="TitleAboutButton_Click"
                        Padding="12,5" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneClosed="NavView_PaneClosed"
            PaneOpened="NavView_PaneOpened"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavTestItem"
                    Content="Test"
                    IsSelected="True"
                    Tag="test">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavNexusItem" Content="Nexus" Tag="nexus">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBackupItem" Content="Backup" Tag="backup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavQuarantineItem" Content="Quarantine" Tag="quarantine">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDebugItem" Content="Debug" Tag="debug">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAdvancedItem" Content="Advanced" Tag="advanced">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel x:Name="FooterPanel" Padding="12,16,12,12" Spacing="6">
                    <TextBlock
                        x:Name="ThemeLabel"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.7" />
                    <ComboBox
                        x:Name="ThemeCombo"
                        MinWidth="140"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="ThemeCombo_SelectionChanged" />
                    <TextBlock
                        x:Name="LanguageLabel"
                        Margin="0,12,0,0"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="LangEnButton" Click="LangEnButton_Click" Content="English" />
                        <Button x:Name="LangZhButton" Click="LangZhButton_Click" Content="中文" />
                    </StackPanel>
                    <TextBlock
                        x:Name="VersionText"
                        Margin="0,12,0,0"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.5" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
