<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RoNCT.App.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,16,24,24" Spacing="12">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="PageBodyText" Opacity="0.8" />

            <TextBlock x:Name="GameSectionText" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBox x:Name="GameRootBox" Header="GameRoot" />
            <TextBox x:Name="ExePathBox" Header="ExePath" />
            <TextBox x:Name="ExtraArgsBox" Header="ExtraArgs" />
            <CheckBox x:Name="CloseRunningBox" Content="CloseRunning" />
            <CheckBox x:Name="AutoCalibrateBox" Content="AutoCalibrate" />

            <TextBlock x:Name="TimingSectionText" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBox x:Name="StableBox" Header="StableSeconds" />
            <TextBox x:Name="StartupBox" Header="StartupTimeoutSeconds" />
            <TextBox x:Name="MenuHoldBox" Header="MenuHoldSeconds" />

            <TextBlock x:Name="ToolsSectionText" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBox x:Name="RepakBox" Header="repak.exe" />
            <TextBox x:Name="DotnetBox" Header="dotnet.exe" />
            <TextBox x:Name="UAssetCliBox" Header="UAssetCLI.dll" />
            <TextBox x:Name="EngineBox" Header="Engine" />
            <TextBox x:Name="AssetLimitBox" Header="AssetLimit" />
            <TextBox x:Name="WorkersBox" Header="Workers" />
            <CheckBox x:Name="AnalyzeDepsBox" Content="AnalyzeDeps" />

            <TextBlock x:Name="BackupSectionText" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <CheckBox x:Name="BackupEnabledBox" Content="BackupEnabled" />
            <TextBox x:Name="BackupMaxFileBox" Header="BackupMaxFileMb" />
            <TextBox x:Name="BackupMaxTotalBox" Header="BackupMaxTotalMb" />
            <TextBox x:Name="ReportDirBox" Header="ReportDir" />
            <TextBox x:Name="BackupDirBox" Header="BackupDir" />
            <TextBox x:Name="QuarantineDirBox" Header="QuarantineDir" />

            <Button x:Name="BtnSave" Click="BtnSave_Click" />
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
