<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RoNCT.App.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="14">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="PageBodyText" Opacity="0.8" />

            <TextBlock x:Name="BackupPathText" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnCreateBackup" Click="BtnCreateBackup_Click" />
                <Button x:Name="BtnRestore" Click="BtnRestore_Click" />
                <Button x:Name="BtnOpenBackup" Click="BtnOpenBackup_Click" />
            </StackPanel>

            <TextBlock x:Name="BackupListHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <ListView
                x:Name="BackupList"
                Height="280"
                SelectionMode="None"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled" />
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
