<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RoNCT.App.Pages.NexusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="14">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="PageBodyText" Opacity="0.8" />

            <TextBlock x:Name="KeyLabel" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox
                    x:Name="ApiKeyBox"
                    Grid.Column="0"
                    MinWidth="240"
                    MaxLength="256" />
                <Button x:Name="BtnSaveKey" Grid.Column="1" Click="BtnSaveKey_Click" />
                <Button x:Name="BtnTutorial" Grid.Column="2" Click="BtnTutorial_Click" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnIdentify" Click="BtnIdentify_Click" />
                <Button x:Name="BtnDeps" Click="BtnDeps_Click" />
            </StackPanel>

            <ListView
                x:Name="ResultList"
                MaxHeight="320"
                SelectionMode="Single"
                SelectionChanged="ResultList_SelectionChanged"
                ItemsSource="{x:Bind ResultRows}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Author}" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnOpenResult" Click="BtnOpenResult_Click" IsEnabled="False" />
                <Button x:Name="BtnConfirmResult" Click="BtnConfirmResult_Click" IsEnabled="False" />
                <Button x:Name="BtnCandidatesResult" Click="BtnCandidatesResult_Click" IsEnabled="False" />
                <Button x:Name="BtnIgnoreResult" Click="BtnIgnoreResult_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
