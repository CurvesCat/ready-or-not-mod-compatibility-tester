<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RoNCT.App.Pages.QuarantinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PageTitle" Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="QuarantinePathText" Grid.Row="1" Opacity="0.75" />
        <ListView
            x:Name="QuarantineList"
            Grid.Row="2"
            SelectionMode="Multiple"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Enabled" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BtnOpenQuarantine" Click="BtnOpenQuarantine_Click" />
            <Button x:Name="BtnDeleteSelected" Click="BtnDeleteSelected_Click" />
            <Button x:Name="BtnEmpty" Click="BtnEmpty_Click" />
        </StackPanel>
        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Opacity="0.8"
            TextWrapping="Wrap" />
    </Grid>
</Page>
