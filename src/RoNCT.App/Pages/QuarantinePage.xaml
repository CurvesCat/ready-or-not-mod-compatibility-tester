<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RoNCT.App.Pages.QuarantinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="14">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="PageBodyText" Opacity="0.8" />
            <TextBlock x:Name="QuarantinePathText" Opacity="0.75" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnOpenQuarantine" Click="BtnOpenQuarantine_Click" />
                <Button x:Name="BtnDeleteSelected" Click="BtnDeleteSelected_Click" />
                <Button x:Name="BtnEmpty" Click="BtnEmpty_Click" />
            </StackPanel>

            <ListView
                x:Name="QuarantineList"
                Height="280"
                SelectionMode="Multiple"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled" />
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
